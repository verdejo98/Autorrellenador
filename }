					"entry.601368857": Datos.MontoVenta,
					"entry.1658044835": Datos.CodAut,
					"entry.223628795": Datos.CodCom,
					"entry.674009346": Datos.EstadoOrden,
					"entry.1287609585_year": Datos.AnoVenta,
					"entry.1287609585_month": Datos.MesVenta,
					"entry.1287609585_day": Datos.DiaVenta,
					"entry.1570111549": Responsable,
					"entry.1406189435": Datos.TipoOrden
				});
				break;
			case "Reversa Débito":
				parametros = new URLSearchParams({
					"emailAddress": Correo,
