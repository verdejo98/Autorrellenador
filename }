MiFormulario.addEventListener('submit', async (event) => {
	event.preventDefault();

	try {
		const Datos = await rescatarDatos();

		if (Datos.EstadoOrden === "Aprobada") {
			alert("Esta orden está aprobada. No se puede generar el formulario.");
			return;
		};

		const Ncaso = document.getElementById('Caso').value;
		const Responsable = Usuario[0];
		const Correo = Usuario[1];
		
		let parametros;
		switch (Datos.TipoSolicitud) {
			case "Reversa Crédito":
				parametros = new URLSearchParams({
					"emailAddress": Correo,
