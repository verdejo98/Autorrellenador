async function rescatarDatos() {
	const [tab] = await chrome.tabs.query({ active: true, currentWindow: true });
	if (!tab?.id) {
		throw new Error('No se encontró la pestaña activa.');
	}

	const [resultado] = await chrome.scripting.executeScript({
		target: { tabId: tab.id },
		func: () => {
			function DebitoCredito(){
				switch (document.querySelectorAll('.css-tuh9u2')[23].innerText){
				case "DEBIT_CARD":
					return "Reversa D\u00e9bito";
				case "CREDIT_CARD":
					return "Reversa Cr\u00e9dito";
				}
			};

			function Flag(){
				switch (document.querySelectorAll('.css-tuh9u2')[27].innerText){
				case "PARIS":
					return "Paris";
				case "MKP":
					return "Marketplace";
				case "FF_MKP":
					return "FFbyParis";
				}
			};

			function EstadoOC(){
				switch (document.querySelectorAll('.css-tuh9u2')[13].innerText){
				case "REJECTED":
					return "Rechazada";
				case "APPROVED":
					return "Aprobada";
				case "PROCESSING":
					return "Sin Gestion";
				case "INIT":
					return "INIT";
				case "DISCARDED":
					return "Discarted";
				}
			};

			function CualFecha(){
			switch (document.querySelectorAll('.css-tuh9u2')[23].innerText){
				case "CREDIT_CARD":
					return 5;
					
				case "DEBIT_CARD":
					return 16;
			}};	
			const fecha = CualFecha();
			const etiquetas = document.querySelectorAll('.css-tuh9u2');
			const fechaVenta = etiquetas[fecha].innerText.split(", ")[0].split("/");
			const fechaNC= etiquetas.[16].innerText.split(", ")[0];
			const TipoSolicitud = DebitoCredito();
			const TipoOrden = Flag();
			const EstadoOrden = EstadoOC();
			const limpiarNumero = (valor) => valor.replace(/[^0-9]/g, '');

			return {
				TipoSolicitud,
				TipoOrden,
				NC: etiquetas[2].innerText,
				OC: etiquetas[1].innerText,
				MontoNC: limpiarNumero(etiquetas[3].innerText),
				MontoVenta: limpiarNumero(etiquetas[4].innerText),
				CodAut: etiquetas[7].innerText,
				CodCom: etiquetas[11].innerText.slice(4),
				DiaVenta: fechaVenta[0],
				MesVenta: fechaVenta[1],
				AnoVenta: fechaVenta[2],
				fechaNC,
				EstadoOrden
			};
		}
	});

	return resultado.result;
}

