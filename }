					"entry.1669909548": Responsable,
					"entry.827167559": Datos.TipoOrden
				});
				break;
			}
		const url = `${LinkBase}&${parametros.toString()}`;
		console.log('URL generada:', url);
		
		chrome.tabs.create({ url });
	} catch (error) {
		console.error('No se pudieron rescatar los datos:', error);
	}
});

